{
  "manifest_version": 3,
  "name": "CRM · WhatsApp (Visão LP)",
  "version": "2.9.1",
  "key": "",
  "description": "O card do CRM (Visão LP) — o mesmo do app — ao lado da conversa aberta no WhatsApp Web e no Umbler Talk: etapa, funil, status, listas, tarefas, agenda, valor, jornada. Nunca envia mensagem sozinho (anti-ban).",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting",
    "declarativeNetRequest",
    "identity"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app-utalk.umbler.com/*",
    "https://cjieobmdpqcupzdpckef.supabase.co/*",
    "https://juca-alt.github.io/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "CRM · abrir o card ao lado da conversa (WhatsApp Web / Umbler Talk)"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "config.js",
        "normalize.js",
        "content/wa-dom.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app-utalk.umbler.com/*"
      ],
      "js": [
        "config.js",
        "normalize.js",
        "content/umbler-dom.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/panel.css",
        "content/embed.html",
        "content/embed.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://app-utalk.umbler.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "crm_frame",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
