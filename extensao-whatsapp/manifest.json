{
  "manifest_version": 3,
  "name": "CRM · WhatsApp (Visão LP)",
  "version": "2.4.0",
  "description": "Ficha do negócio do CRM (Visão LP) dentro do painel da extensão, ao lado da conversa do WhatsApp Web — o mesmo card do CRM, com etapa, status, listas, tarefas, agenda e jornada. Nunca envia mensagem sozinho (anti-ban).",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://cjieobmdpqcupzdpckef.supabase.co/*",
    "https://juca-alt.github.io/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "side_panel": {
    "default_path": "content/embed.html"
  },
  "action": {
    "default_title": "CRM · card completo (painel lateral)"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "config.js",
        "normalize.js",
        "content/wa-dom.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/panel.css",
        "content/embed.html",
        "content/embed.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "crm_frame",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
