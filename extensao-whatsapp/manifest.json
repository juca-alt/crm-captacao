{
  "manifest_version": 3,
  "name": "CRM · WhatsApp (Visão LP)",
  "version": "2.1.0",
  "description": "Ficha do negócio do CRM (Visão LP) ao lado da conversa no WhatsApp Web — o mesmo card do CRM, com etapa, status, listas, tarefas, agenda e jornada. Nunca envia mensagem sozinho (anti-ban).",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://cjieobmdpqcupzdpckef.supabase.co/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "config.js",
        "normalize.js",
        "content/wa-dom.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/panel.css",
        "content/embed.html",
        "content/embed.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}