{
  "manifest_version": 3,
  "name": "CRM · WhatsApp (Captação + Visão LP)",
  "version": "2.0.0",
  "description": "Card da oportunidade ao lado da conversa no WhatsApp Web: etapa, status, motivo de perda, listas de TA e notas com o mesmo cadastro do CRM. Lê o DOM e nunca envia mensagem sozinho (anti-ban).",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://cjieobmdpqcupzdpckef.supabase.co/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "config.js",
        "normalize.js",
        "content/wa-dom.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/panel.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}